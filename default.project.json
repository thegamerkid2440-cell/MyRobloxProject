{
  "name": "MyRobloxProject",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      },
      "Remotes": {
        "$className": "Folder"
      }
    },

    "ServerScriptService": {
      "CombinedScript": {
        "$className": "Script",
        "$path": "CombinedScript.lua"
      },
      "OriginalServerScripts": {
        "$path": "src/ServerScriptService"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "CombinedScript": {
          "$className": "LocalScript",
          "$path": "CombinedScript.lua"
        },
        "OriginalClientScripts": {
          "$path": "src/StarterPlayer/StarterPlayerScripts"
        }
      }
    },

    "StarterGui": {
      "MainGui": {
        "$className": "ScreenGui",
        "$path": "src/StarterGui/MainGui"
      }
    }
  }
}
